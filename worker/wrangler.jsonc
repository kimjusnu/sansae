{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "junsu-portfolio-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",

  // Workers AI is reached through this binding, so no API key exists to leak.
  // It always runs against Cloudflare's edge — even `wrangler dev` bills usage.
  "ai": { "binding": "AI" },

  // Per-IP rate limiting. Without this the limiter fails open, which would
  // leave a public LLM endpoint with no ceiling.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "c043dcdc1b944b26b3c0016bf786d8fa" }
  ],

  "observability": { "enabled": true }
}
